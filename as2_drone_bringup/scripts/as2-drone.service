# =============================================================================
# as2-drone.service
# systemd 서비스 파일 — 드론 컴퓨터 부팅 시 as2 노드 자동 실행.
#
# 설치 방법:
#   1. 이 파일을 /etc/systemd/system/ 에 복사
#      sudo cp as2-drone.service /etc/systemd/system/
#
#   2. 환경에 맞게 수정
#      - User=         드론 컴퓨터 사용자 이름
#      - ExecStart=    drone_bringup.sh 경로 및 옵션
#
#   3. 서비스 등록 및 활성화
#      sudo systemctl daemon-reload
#      sudo systemctl enable as2-drone.service
#      sudo systemctl start  as2-drone.service
#
#   4. 상태 확인
#      sudo systemctl status as2-drone.service
#      journalctl -u as2-drone.service -f
# =============================================================================

[Unit]
Description=AeroStack2 Drone Bringup Service
# 네트워크 인터페이스 준비 후 시작 (DDS Discovery 필요)
After=network-online.target
Wants=network-online.target

[Service]
# -------------------------------------------------------------------------
# 아래 값을 실제 환경에 맞게 수정하세요.
# -------------------------------------------------------------------------
User=ubuntu
Group=ubuntu

# ROS2 디스트리뷰션 (humble / iron / jazzy)
Environment="ROS_DISTRO=humble"

# 워크스페이스 경로
Environment="AS2_WS=/home/ubuntu/ros2_ws"

# ROS_DOMAIN_ID (다른 ROS2 장비와 격리 시 설정)
Environment="ROS_DOMAIN_ID=0"

# 드론 네임스페이스 (drone_bringup.sh -n 옵션으로 전달)
Environment="AS2_NAMESPACE=drone0"

# -------------------------------------------------------------------------
# 실행 명령
# drone_bringup.sh 가 설치된 경로를 지정한다.
# colcon install 후: ~/ros2_ws/install/as2_drone_bringup/share/as2_drone_bringup/scripts/drone_bringup.sh
# -------------------------------------------------------------------------
ExecStart=/home/ubuntu/ros2_ws/install/as2_drone_bringup/share/as2_drone_bringup/scripts/drone_bringup.sh \
    --namespace %E{AS2_NAMESPACE} \
    --log-level info

# 종료 시 하위 프로세스(ros2 launch) 전체 종료
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=10

# 비정상 종료 시 10초 후 재시작
Restart=on-failure
RestartSec=10

# 로그 출력
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

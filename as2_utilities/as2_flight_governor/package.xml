<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>as2_flight_governor</name>
  <version>1.1.3</version>
  <description>Declarative safety layer for Aerostack2: checks every motion reference against YAML policies (geofence, keep-out, speed limits) and allows, clamps or vetoes it before it reaches the motion controller</description>

  <maintainer email="cvar.upm3@gmail.com">CVAR-UPM</maintainer>
  <license>BSD-3-Clause</license>

  <author>Vishwa</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>as2_core</depend>
  <depend>as2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

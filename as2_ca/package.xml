<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>as2_ca</name>
  <version>0.0.0</version>
  <description>Collective Awareness (CA) middleware for Aerostack2: peer-to-peer modelet exchange between drone instances via the CA Gateway node and CAGatewayClient library (CoreSense Resilience Essential, WP7/TB2)</description>
  <maintainer email="g.glenza@upm.es">Guillermo GP-Lenza</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>as2_msgs</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

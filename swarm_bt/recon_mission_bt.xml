<?xml version="1.0"?>
<!--
  recon_mission_bt.xml — 임무 분해, 할당, 수행, 완료 모니터링 전체를 담당
  
-->
<root main_tree_to_execute="ReconMission">

  <BehaviorTree ID="ReconMission">
    <Sequence name="ReconLifecycle">

      <!-- PHASE 1: 임무 분해 -->
      <!-- 리더만 실행. 임무구역을 드론 수만큼 분할하고 블랙보드에 기록 -->
      <Sequence name="MissionDecompose">
        <IsLeader drone_id="{drone_id}"/>
        <DecomposeMissionArea
          area="{mission_area}"
          drone_count="{swarm_size}"
          output_assignments="{zone_assignments}"/>
        <PublishAssignments
          topic="/swarm/zone_assignments"
          assignments="{zone_assignments}"/>
      </Sequence>

      <!-- PHASE 2: 임무 할당 수신 (팔로워) -->
      <!-- 리더는 이미 위에서 설정, 팔로워는 토픽에서 수신 -->
      <Fallback name="ReceiveMyZone">
        <IsLeader drone_id="{drone_id}"/>  <!-- 리더는 패스 -->
        <SubscribeMyZone
          topic="/swarm/zone_assignments"
          drone_id="{drone_id}"
          output_zone="{my_zone}"
          timeout_sec="10"/>
      </Fallback>

      <!-- PHASE 3: 임무구역까지 편대비행 -->
      <SubTree ID="FormationFlight"
        target_area="{mission_area}"
        formation_type="delta"/>

      <!-- PHASE 4: 각 드론별 정찰 수행 -->
      <SubTree ID="ReconExec"
        zone="{my_zone}"/>

      <!-- PHASE 5: 임무 완료 모니터링 -->
      <!-- 리더가 전체 드론의 구역 완료 상태를 집계 -->
      <Sequence name="CompletionMonitor">
        <Fallback>
          <IsLeader drone_id="{drone_id}"/>
          <ReportZoneComplete
            topic="/swarm/zone_status"
            drone_id="{drone_id}"
            zone="{my_zone}"/>
        </Fallback>
        <Fallback>
          <!-- 팔로워는 리더의 MissionComplete 신호 대기 -->
          <IsFollower drone_id="{drone_id}"/>
          <WaitForAllZonesComplete
            topic="/swarm/zone_status"
            expected_count="{swarm_size}"
            timeout_sec="600"/>
        </Fallback>
      </Sequence>

    </Sequence>
  </BehaviorTree>

</root>

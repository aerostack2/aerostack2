<?xml version="1.0"?>
<!--
  mission_dispatcher.xml — 블랙보드 mission_type 값으로 분기
  
-->
<root main_tree_to_execute="MissionDispatcher">

  <BehaviorTree ID="MissionDispatcher">
    <!--
      Fallback: 첫 번째 Sequence의 IsType 조건이 FAILURE이면
      다음 Sequence로 넘어가는 패턴으로 임무 타입 분기.
    -->
    <Fallback>

      <Sequence name="ReconBranch">
        <IsType mission_type="{mission_type}" expected="recon"/>
        <SubTree ID="ReconMission"/>
      </Sequence>

      <Sequence name="SurvBranch">
        <IsType mission_type="{mission_type}" expected="surveillance"/>
        <SubTree ID="SurvMission"/>
      </Sequence>

      <Sequence name="TrackBranch">
        <IsType mission_type="{mission_type}" expected="tracking"/>
        <SubTree ID="TrackMission"/>
      </Sequence>

      <!-- 알 수 없는 임무 타입: 호버 유지 후 GCS 재명령 대기 -->
      <Sequence name="UnknownMission">
        <HoverInPlace/>
        <WaitForNewMission timeout_sec="60"/>
      </Sequence>

    </Fallback>
  </BehaviorTree>

</root>

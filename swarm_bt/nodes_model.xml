<?xml version="1.0"?>
<!--
  nodes_model.xml
  AS2_SWARM_BT_DISPATCH_DESIGN.md §6 커스텀 BT 노드 + 재사용 AS2 노드 포트 선언 (Groot2).
  coordinator/per-drone 루트가 공통 include. 제어노드(Parallel/Fallback/Sequence/
  SequenceStar/ReactiveFallback/ReactiveSequence/KeepRunningUntilFailure/Inverter/SubTree)는
  BT.CPP 내장이라 생략.
-->
<root>
  <TreeNodesModel>

    <!-- ===== §6.1 군집 조율 ===== -->
    <Condition ID="HasMissionType">
      <input_port name="type">현재 임무종류 (블랙보드 {mtype})</input_port>
      <input_port name="match">EOIR_RECON / RF_RECON / SURVEIL / TRACK</input_port>
    </Condition>
    <Decorator ID="LatchMissionType">
      <input_port name="topic_name" default="swarm/mission_intent">임무 의도 토픽</input_port>
      <input_port name="lock_phases" default="WORK,LANDING">타입전환 금지 단계 (flap 방지)</input_port>
    </Decorator>
    <Action ID="PublishPhase">
      <input_port name="phase">TAKEOFF/TRANSIT/WORK/REGROUP/LANDING → /swarm/mission_phase</input_port>
    </Action>
    <Action ID="SwarmFlockingStart">
      <input_port name="formation" default="line">편대 형태: line/wedge/grid</input_port>
      <input_port name="spacing" default="5.0">기체 간격 (m)</input_port>
      <input_port name="centroid" default="">virtual_centroid (빈값=현 군집중심)</input_port>
    </Action>
    <Action ID="SwarmFlockingStop"/>   <!-- deactivate / 각 DroneSwarm stopFollowReference -->
    <Action ID="ModifyFormation">
      <input_port name="formation" default="line">modify_swarm 재편대/detach</input_port>
    </Action>
    <Action ID="DriveCentroid">
      <input_port name="target">목표점 "x;y;z" 또는 블랙보드</input_port>
      <input_port name="speed" default="4.0">centroid 이동 속도 (m/s)</input_port>
    </Action>

    <!-- ===== §6.2 동기 barrier (집계서비스 폴링) ===== -->
    <Condition ID="AwaitAllAirborne"/>   <!-- 전 드론 armed + 고도≥임계 -->
    <Condition ID="AwaitFormed"/>        <!-- 전 DroneSwarm checkPosition(0.3m) -->
    <Condition ID="AwaitAllZonesDone"/>  <!-- 전 드론 WORK 완료 -->
    <Condition ID="AwaitAllLanded"/>     <!-- 전 드론 landed/disarmed -->

    <!-- ===== §6.3 per-drone 게이트/슬롯 ===== -->
    <Condition ID="PhaseIs">
      <input_port name="phase">현 단계 == match (/swarm/mission_phase 구독)</input_port>
    </Condition>
    <Decorator ID="WaitForAlert">
      <input_port name="topic_name">AlertEvent 토픽</input_port>
      <output_port name="alert">수신 alert 코드</output_port>
    </Decorator>
    <Decorator ID="WaitTakeoffSlot">
      <input_port name="topic_name" default="swarm/telemetry">전 드론 텔레메트리 (airborne 판정)</input_port>
      <input_port name="task_topic" default="swarm_agent/task">자기 배정 (takeoff_slot)</input_port>
    </Decorator>
    <Decorator ID="WaitLandSlot">
      <input_port name="topic_name" default="swarm/telemetry">전 드론 텔레메트리 (landed 판정)</input_port>
      <input_port name="task_topic" default="swarm_agent/task">자기 배정 (land_slot)</input_port>
    </Decorator>
    <Action ID="SafeHover"/>   <!-- 항상 RUNNING 호버 (최종 폴백) -->

    <!-- ===== §6.4 임무 P3 전용 (인식/측위/계획) ===== -->
    <!-- coordinator 측 계획 -->
    <Action ID="PartitionAndAssign">
      <input_port name="zones">정찰구역 폴리곤 (블랙보드 {recon_area})</input_port>
      <input_port name="route_out" default="swarm_agent/task">분할 sub_route 배포 토픽</input_port>
    </Action>
    <Action ID="AssignRfSurvey">
      <input_port name="route_out" default="swarm_agent/task">측위 경로/형태 배포</input_port>
      <input_port name="mode" default="triangulate">triangulate/df/loiter_peak</input_port>
    </Action>
    <Action ID="FuseDetections">
      <input_port name="in" default="perception/detections">드론별 탐지 입력</input_port>
      <input_port name="out" default="swarm/targets">융합 표적 출력</input_port>
    </Action>
    <Action ID="FuseEmitters">
      <input_port name="in" default="rf/bearings">드론별 방위 입력</input_port>
      <input_port name="out" default="swarm/emitters">삼각측량 방사원 출력</input_port>
    </Action>
    <Action ID="AllocateTrackRoles">
      <input_port name="target_in" default="swarm/targets">표적 입력</input_port>
      <input_port name="role_out" default="swarm_agent/task">TRACKER/RELAY 역할 배포</input_port>
    </Action>
    <!-- per-drone 측 인식/측위 -->
    <Action ID="DetectObjects">
      <input_port name="server_name" default="DetectObjectsBehavior">DetectObjects 액션서버</input_port>
      <input_port name="classes">탐지 클래스 필터 (블랙보드 {target_classes}, 빈값=전체)</input_port>
      <input_port name="min_score" default="0.5">탐지 신뢰도 임계</input_port>
    </Action>
    <Condition ID="ObjectDetected">
      <input_port name="topic_name" default="perception/detections">탐지 결과 토픽</input_port>
      <input_port name="min_score" default="0.6">선점 트리거 신뢰도 임계</input_port>
      <output_port name="target_pose">탐지 표적 world 좌표 → {detection_pose}</output_port>
    </Condition>
    <Condition ID="InspectTimeout">
      <input_port name="duration" default="15.0">정밀관측 지속시간 (sec)</input_port>
    </Condition>
    <Action ID="RfSurvey">
      <input_port name="route">측위 경유 경로 (블랙보드 {sub_route})</input_port>
      <input_port name="mode" default="triangulate">RF 기동: triangulate/df/loiter_peak</input_port>
    </Action>
    <Condition ID="EmitterDetected">
      <input_port name="topic_name" default="rf/bearings">RF 방위 토픽</input_port>
      <output_port name="emitter_pose">추정 방사원 위치 → {emitter_pose}</output_port>
    </Condition>
    <Condition ID="HasRole">
      <input_port name="role">현재 역할 (블랙보드 {role})</input_port>
      <input_port name="match">TRACKER / RELAY</input_port>
    </Condition>
    <Condition ID="TargetLost">
      <input_port name="topic_name" default="swarm/targets">표적 토픽 (소실 감지)</input_port>
    </Condition>

    <!-- ===== 안전/공통 ===== -->
    <Condition ID="IsFlying"/>
    <Condition ID="BatteryLow">
      <input_port name="threshold" default="0.25">RTB 배터리 임계</input_port>
    </Condition>

    <!-- ===== 재사용: AS2 기존 BT 노드 ===== -->
    <Action ID="Arm">
      <input_port name="service_name" default="set_arming_state"/>
    </Action>
    <Action ID="Offboard">
      <input_port name="service_name" default="set_offboard_mode"/>
    </Action>
    <Action ID="Takeoff">
      <input_port name="height" default="2.0">이륙 고도 (m)</input_port>
      <input_port name="speed" default="0.5">이륙 속도 (m/s)</input_port>
    </Action>
    <Action ID="Land">
      <input_port name="speed" default="0.5">착륙 속도 (m/s)</input_port>
    </Action>
    <Action ID="GoTo">
      <input_port name="pose">목표 위치 "x;y;z" 또는 블랙보드</input_port>
      <input_port name="max_speed">최대 속도 (m/s)</input_port>
      <input_port name="yaw_angle" default="0.0">목표 요 (rad)</input_port>
      <input_port name="yaw_mode" default="0">0=KEEP_YAW 1=PATH_FACING 2=FIXED_YAW</input_port>
    </Action>
    <Action ID="FollowPath">
      <input_port name="path">웨이포인트 또는 블랙보드 {sub_route}</input_port>
      <input_port name="speed">최대 속도 (m/s)</input_port>
      <input_port name="yaw_mode" default="1">0=KEEP_YAW 1=PATH_FACING 2=FIXED_YAW</input_port>
    </Action>
    <Action ID="FollowReference">
      <input_port name="server_name" default="FollowReferenceBehavior">슬롯 추종 (편대)</input_port>
    </Action>
    <Action ID="PointGimbal">
      <input_port name="frame_id" default="earth">지향 기준 프레임</input_port>
      <input_port name="mode" default="2">짐벌 제어 모드</input_port>
      <input_port name="yaw" default="0.0">요 (rad)</input_port>
      <input_port name="pitch" default="1.57">피치 (rad, 1.57=하향)</input_port>
      <input_port name="roll" default="0.0">롤 (rad)</input_port>
    </Action>

  </TreeNodesModel>
</root>

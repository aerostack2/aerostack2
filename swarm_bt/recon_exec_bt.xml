<?xml version="1.0"?>
<!--
  recon_exec_bt.xml — 구역 배정, 경로 생성, 경로 비행, 카메라 촬영을 담당
  
-->
<root main_tree_to_execute="ReconExec">

  <BehaviorTree ID="ReconExec">
    <Sequence name="ReconExecution">

      <!-- STEP 1: 내 구역으로 단독 이동 -->
      <GoTo
        target="{my_zone.entry_point}"
        speed="5.0"/>

      <!-- STEP 2: 구역 내 비행 경로 생성 (lawnmower 패턴) -->
      <GenerateReconPath
        zone="{my_zone}"
        pattern="lawnmower"
        overlap_m="10"
        altitude_m="{recon_altitude}"
        output_path="{recon_path}"/>

      <!-- STEP 3: 경로 비행 + 카메라 촬영 병렬 수행 -->
      <!--
        Parallel: 비행과 촬영을 동시에.
        비행이 완료되면(SUCCESS) 촬영도 종료.
        촬영 오류는 WARNING으로 처리, 비행 중단 안 함.
      -->
      <Parallel success_count="1" failure_count="2">

        <!-- 비행 경로 추종 -->
        <FollowPath
          path="{recon_path}"
          speed="3.0"
          acceptance_radius_m="2"/>

        <!-- 카메라 촬영: 경로 비행 중 상시 촬영 -->
        <ReactiveSequence name="CameraOps">
          <CameraHealthy/>  <!-- 카메라 이상 시 재시도 -->
          <Sequence>
            <StartCameraRecording
              mode="continuous"
              output_topic="/recon/images"/>
            <WaitForPathComplete
              path_topic="/drone/path_status"/>
            <StopCameraRecording/>
            <SaveReconData
              drone_id="{drone_id}"
              zone="{my_zone}"
              topic="/recon/mission_data"/>
          </Sequence>
        </ReactiveSequence>

      </Parallel>

      <!-- STEP 4: 구역 정찰 완료 확인 -->
      <SetBlackboard
        output_key="zone_complete"
        value="true"/>

    </Sequence>
  </BehaviorTree>

</root>
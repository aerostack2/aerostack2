<?xml version="1.0"?>
<!--
  swarm_root.xml  —  SwarmRoot 최상위 진입점 (WBS 1.6.8)
  시나리오: AS2_SWARM_SCENARIO_BY_PHASE.md 전 구간(P0~P5) 통합 진입점.
  전 드론에 동일 트리 배포. P0 완료 후 IsLeader로 리더/팔로워 자기선택.

  ┌─ SwarmRoot ──────────────────────────────────────────────┐
  │  Parallel (success=1, failure=1)                          │
  │  ├─ [RUNNING] heartbeat 지속 발행                         │
  │  ├─ [선점] P0 부트스트랩 → IsLeader 자기선택              │
  │  │     leader  → SwarmCoord (swarm_mission_root.xml)      │
  │  │     follower → SwarmDrone (swarm_perdrone_root.xml)    │
  │  └─ (비상·배터리 선점은 각 루트 내부 Parallel에서 처리)   │
  └──────────────────────────────────────────────────────────┘

  비상 처리 분리 원칙:
    리더(SwarmCoord): WaitForAlert → EmergencyAll  (전기 EMERGENCY 방송)
    팔로워(SwarmDrone): WaitForAlert → Dx_Emergency  (개별 RTB)
    배터리 RTB(SwarmDrone): AwaitBatteryLow → Dx_BatteryRTB

  include 의존:
    bootstrap/bootstrap_subtrees.xml  (BootstrapAll)
    swarm_mission_root.xml            (SwarmCoord)
    swarm_perdrone_root.xml           (SwarmDrone)
    nodes_model.xml                   (노드 선언)
-->
<root main_tree_to_execute="SwarmRoot">

  <include path="bootstrap/bootstrap_subtrees.xml"/>
  <include path="swarm_mission_root.xml"/>
  <include path="swarm_perdrone_root.xml"/>
  <include path="nodes_model.xml"/>

  <!--
    SwarmRoot: 전 드론 공통 최상위 진입점.
    heartbeat는 임무 전 구간(P0~P5) RUNNING 유지.
    BootstrapAll(P0) SUCCESS → IsLeader 자기선택 → 임무 루트 진입.
    리더십 변경(election) 시 IsLeader 재평가 → ReactiveFallback이 즉시 역할 전환.
  -->
  <BehaviorTree ID="SwarmRoot">
    <Parallel success_threshold="1" failure_threshold="1">

      <!--
        heartbeat 임무 전 구간 지속 발행.
        BootstrapAll 내부 heartbeat와 중복처럼 보이나,
        BootstrapAll 종료(SUCCESS) 후 임무 중에도 RUNNING 유지하기 위해 분리.
      -->
      <KeepRunningUntilFailure>
        <Action ID="PublishHeartbeat" topic_name="swarm/heartbeat"/>
      </KeepRunningUntilFailure>

      <!--
        메인 흐름: P0 → 임무 자기선택.
        SequenceStar: BootstrapAll SUCCESS 후 dispatcher 진입.
        ReactiveFallback: 매 tick IsLeader 재평가 (리더십 변경 즉시 반영).
      -->
      <SequenceStar>

        <!-- P0 부트스트랩: AwaitBoot → ReportHealth → SwarmJoin → QuorumReady → MissionReady -->
        <SubTree ID="BootstrapAll" __shared_blackboard="true"/>

        <!-- P0-3 IsLeader 자기선택 dispatcher -->
        <ReactiveFallback>

          <!--
            리더 경로: IsLeader 참 → SwarmCoord 실행.
            리더 사망·승계 시 IsLeader 거짓 → 차순위가 리더로 전환, 이 드론은 SwarmDrone으로.
          -->
          <ReactiveSequence>
            <Condition ID="IsLeader"/>
            <SubTree ID="SwarmCoord" __shared_blackboard="true"/>
          </ReactiveSequence>

          <!--
            팔로워 경로: IsLeader 거짓 → SwarmDrone 실행.
            비상·배터리 선점은 SwarmDrone Parallel 내부에서 처리.
          -->
          <SubTree ID="SwarmDrone" __shared_blackboard="true"/>

        </ReactiveFallback>
      </SequenceStar>

    </Parallel>
  </BehaviorTree>

</root>

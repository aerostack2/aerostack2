<?xml version="1.0" encoding="UTF-8"?>
<!--
  recon_mission_v4.xml
  ============================================================
  역할  : 정찰 임무 전체 라이프사이클
           Phase 1. 임무 분해  (리더: 구역 분할 + 슬롯 배정 → 토픽 발행)
           Phase 2. 임무 할당  (팔로워: 토픽 수신 → my_zone / my_slot 설정)
           Phase 3. 임무구역까지 편대비행
           Phase 4. 드론별 정찰 수행
           Phase 5. 완료 모니터링 (리더: 전체 집계)
  블랙보드 (포트로 수신)
           drone_id, leader_id, swarm_size
           mission_area, mission_id, battery_threshold
  블랙보드 (내부 생성, SubTree 종료 시 소멸)
           zone_assignments, my_zone, my_slot, rendezvous_point
           formation_offset, zone_rendezvous, safe_altitude, recon_altitude

  v4 변경점 (B안 · 명시적 슬롯 표면화)
    - DecomposeMissionArea가 구역과 함께 편대 슬롯(slot_index)을 배정.
      리더 권위로 안정 정렬 기반 결정적·전단사 배정 (리더=slot 0).
      ※ 출격 중에는 슬롯을 재번호하지 않는다. 드론 이탈로 생긴
        빈 슬롯은 유지하고, 재편성이 필요하면 FormationHealthy
        실패 → 명시적 재집결 단계로 처리 (비행 중 대형 출렁임 방지).
    - ExtractMyZone / SubscribeMyZone 가 my_zone과 함께 my_slot 출력.
    - FormationFlight(v3) SubTree에 my_slot 포트로 전달.
  ============================================================
-->
<root BTCPP_format="4" main_tree_to_execute="ReconMission">

  <TreeNodesModel>

    <Condition ID="IsLeader">
      <input_port name="drone_id"/>
      <input_port name="leader_id"/>
    </Condition>

    <Condition ID="IsFollower">
      <input_port name="drone_id"/>
      <input_port name="leader_id"/>
    </Condition>

    <Condition ID="BatteryOK">
      <input_port name="min_percent" default="30"/>
      <input_port name="topic"       default="/battery_state"/>
    </Condition>

    <Action ID="DecomposeMissionArea">
      <input_port  name="area">GeoJSON polygon string</input_port>
      <input_port  name="drone_count"/>
      <input_port  name="pattern" default="grid">grid / strip</input_port>
      <output_port name="zone_assignments">
        JSON: [{drone_id, slot_index, zone_polygon, entry_point, exit_point}]
        slot_index: 안정 정렬 기반 결정적 편대 슬롯 (리더 = 0)
      </output_port>
      <output_port name="rendezvous_point">
        임무구역 외곽 집결 좌표
      </output_port>
    </Action>

    <Action ID="PublishAssignments">
      <input_port name="topic"       default="/swarm/zone_assignments"/>
      <input_port name="assignments" default="{zone_assignments}"/>
      <input_port name="mission_id"  default="{mission_id}"/>
    </Action>

    <Action ID="SubscribeMyZone">
      <input_port  name="topic"      default="/swarm/zone_assignments"/>
      <input_port  name="drone_id"   default="{drone_id}"/>
      <input_port  name="mission_id" default="{mission_id}"/>
      <input_port  name="timeout_sec" default="15"/>
      <output_port name="my_zone">
        {id, polygon, entry_point, exit_point}
      </output_port>
      <output_port name="my_slot">
        리더가 배정한 내 편대 슬롯 인덱스
      </output_port>
    </Action>

    <Action ID="ExtractMyZone">
      <input_port name="assignments" default="{zone_assignments}">
        DecomposeMissionArea에서 생성된 전체 할당 데이터
      </input_port>
      <input_port name="drone_id" default="{drone_id}"/>
      <output_port name="my_zone">
        블랙보드에서 추출한 내 구역 데이터
      </output_port>
      <output_port name="my_slot">
        블랙보드에서 추출한 내 편대 슬롯 인덱스 (리더 = 0)
      </output_port>
    </Action>

    <Action ID="SetBlackboard">
      <input_port  name="value"/>
      <output_port name="output_key"/>
    </Action>

    <Action ID="WaitForAllZonesComplete">
      <input_port  name="topic"          default="/swarm/zone_status"/>
      <input_port  name="expected_count" default="{swarm_size}"/>
      <input_port  name="timeout_sec"    default="600"/>
      <output_port name="completed_count"/>
    </Action>

    <Action ID="PublishMissionComplete">
      <input_port name="topic"      default="/swarm/mission_status"/>
      <input_port name="mission_id" default="{mission_id}"/>
      <input_port name="result"     default="success"/>
    </Action>

    <Action ID="WaitForMissionComplete">
      <input_port name="topic"       default="/swarm/mission_status"/>
      <input_port name="mission_id"  default="{mission_id}"/>
      <input_port name="timeout_sec" default="660"/>
    </Action>

    <BehaviorTree ID="ReconMission">
      <input_port name="drone_id"/>
      <input_port name="leader_id"/>
      <input_port name="swarm_size"/>
      <input_port name="mission_area"/>
      <input_port name="mission_id"/>
      <input_port name="battery_threshold" default="30"/>
    </BehaviorTree>

  </TreeNodesModel>

  <!-- ============================================================
       ReconMission
  ============================================================ -->
  <BehaviorTree ID="ReconMission">
    <ReactiveSequence name="ReconMissionRoot">

      <!--
        정찰 임무 수준 안전 감시.
        root_bt의 BatteryOK(10%)와 별개로
        정찰 중단 임계값(30%)을 포트로 수신하여 적용.
        ZoneIntegrity / CameraSystemOnline은
        recon_exec_bt 내부에서 감시.
      -->
      <BatteryOK
        min_percent="{battery_threshold}"
        topic="/battery_state"/>

      <!-- 정찰 임무 5단계 시퀀스 -->
      <Sequence name="ReconLifecycle">

        <!-- =====================================================
             Phase 1: 임무 분해 + 슬롯 배정 (리더만 실행)
             팔로워는 IsLeader FAILURE → Sequence FAILURE →
             Fallback 다음 자식(Phase 2)으로 즉시 진행
        ===================================================== -->
        <Fallback name="DecomposeOrSkip">
          <Sequence name="LeaderDecompose">
            <IsLeader drone_id="{drone_id}" leader_id="{leader_id}"/>
            <DecomposeMissionArea
              area="{mission_area}"
              drone_count="{swarm_size}"
              pattern="grid"
              zone_assignments="{zone_assignments}"
              rendezvous_point="{rendezvous_point}"/>
            <!-- 리더도 자신의 zone/slot 을 블랙보드에 설정 -->
            <ExtractMyZone
              assignments="{zone_assignments}"
              drone_id="{drone_id}"
              my_zone="{my_zone}"
              my_slot="{my_slot}"/>
            <PublishAssignments
              topic="/swarm/zone_assignments"
              assignments="{zone_assignments}"
              mission_id="{mission_id}"/>
          </Sequence>

          <!-- 팔로워: 리더 발행 대기 후 자기 존/슬롯 수신 -->
          <Sequence name="FollowerReceiveZone">
            <IsFollower drone_id="{drone_id}" leader_id="{leader_id}"/>
            <SubscribeMyZone
              topic="/swarm/zone_assignments"
              drone_id="{drone_id}"
              mission_id="{mission_id}"
              timeout_sec="15"
              my_zone="{my_zone}"
              my_slot="{my_slot}"/>
          </Sequence>
        </Fallback>

        <!-- 고도 설정: 드론 번호 기반 충돌 회피 고도 계산 -->
        <SetBlackboard output_key="recon_altitude" value="50"/>

        <!-- =====================================================
             Phase 2: 임무구역까지 편대비행
        ===================================================== -->
        <SubTree ID="FormationFlight"
                 drone_id="{drone_id}"
                 leader_id="{leader_id}"
                 swarm_size="{swarm_size}"
                 my_slot="{my_slot}"
                 mission_area="{mission_area}"
                 rendezvous_point="{rendezvous_point}"
                 recon_altitude="{recon_altitude}"/>

        <!-- =====================================================
             Phase 3: 드론별 정찰 수행
        ===================================================== -->
        <SubTree ID="ReconExec"
                 drone_id="{drone_id}"
                 leader_id="{leader_id}"
                 swarm_size="{swarm_size}"
                 mission_id="{mission_id}"
                 my_zone="{my_zone}"
                 recon_altitude="{recon_altitude}"
                 battery_threshold="{battery_threshold}"/>

        <!-- =====================================================
             Phase 4: 완료 모니터링
        ===================================================== -->
        <Fallback name="CompletionMonitor">

          <!-- 리더: 전체 드론 완료 집계 후 신호 발행 -->
          <Sequence name="LeaderMonitor">
            <IsLeader drone_id="{drone_id}" leader_id="{leader_id}"/>
            <WaitForAllZonesComplete
              topic="/swarm/zone_status"
              expected_count="{swarm_size}"
              timeout_sec="600"
              completed_count="{completed_count}"/>
            <PublishMissionComplete
              topic="/swarm/mission_status"
              mission_id="{mission_id}"
              result="success"/>
          </Sequence>

          <!-- 팔로워: 리더 완료 신호 대기 -->
          <Sequence name="FollowerWait">
            <IsFollower drone_id="{drone_id}" leader_id="{leader_id}"/>
            <WaitForMissionComplete
              topic="/swarm/mission_status"
              mission_id="{mission_id}"
              timeout_sec="660"/>
          </Sequence>

        </Fallback>

      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>

</root>

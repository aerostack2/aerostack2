<?xml version="1.0" encoding="UTF-8"?>
<!--
  rtb_v2.xml
  ============================================================
  역할  : 임무 완료 후 복귀 및 순차 착륙
           Step 1. 편대 재집결 (각 드론이 RTB 집결점으로 이동)
           Step 2. 홈 포지션까지 편대 비행
           Step 3. 순차 착륙
                   팔로워: 자기 번호 순서에 착륙 슬롯 대기 → 착륙
                   리더:   모든 팔로워 착륙 확인 후 마지막 착륙
  ============================================================
-->
<root BTCPP_format="4" main_tree_to_execute="RTB">

  <TreeNodesModel>

    <Condition ID="IsLeader">
      <input_port name="drone_id"/>
      <input_port name="leader_id"/>
    </Condition>

    <Condition ID="IsFollower">
      <input_port name="drone_id"/>
      <input_port name="leader_id"/>
    </Condition>

    <Condition ID="IsAtPosition">
      <input_port name="target"/>
      <input_port name="tolerance_m" default="5.0"/>
      <input_port name="pose_topic"  default="/self_localization/pose"/>
    </Condition>

    <Action ID="GoTo">
      <input_port name="target"/>
      <input_port name="altitude_m"          default="-1"/>
      <input_port name="speed_mps"           default="5.0"/>
      <input_port name="acceptance_radius_m" default="5.0"/>
    </Action>

    <Action ID="GoToFormation">
      <input_port name="target"/>
      <input_port name="formation_type" default="delta"/>
      <input_port name="speed_mps"      default="8.0"/>
      <input_port name="leader_id"      default="{leader_id}"/>
      <input_port name="drone_id"       default="{drone_id}"/>
    </Action>

    <Action ID="Land">
      <input_port name="speed" default="0.5"/>
    </Action>

    <Action ID="PublishRendezvous">
      <input_port name="topic"     default="/swarm/rtb_rendezvous"/>
      <input_port name="point"     default="{home_rendezvous}"/>
      <input_port name="drone_id"  default="{drone_id}"/>
    </Action>

    <Action ID="ReceiveRendezvous">
      <input_port  name="topic"       default="/swarm/rtb_rendezvous"/>
      <input_port  name="timeout_sec" default="60"/>
      <output_port name="rtb_point"/>
    </Action>

    <Action ID="WaitForFormationAssembled">
      <input_port name="topic"          default="/swarm/formation_status"/>
      <input_port name="expected_count" default="{swarm_size}"/>
      <input_port name="timeout_sec"    default="120"/>
    </Action>

    <Action ID="PublishFormationReady">
      <input_port name="topic"    default="/swarm/formation_status"/>
      <input_port name="drone_id" default="{drone_id}"/>
    </Action>

    <Action ID="ComputeHomeRendezvous">
      <input_port  name="home_position"/>
      <input_port  name="offset_m"      default="50.0"/>
      <output_port name="home_rendezvous"/>
    </Action>

    <Action ID="WaitForLandingClearance">
      <input_port name="topic"       default="/swarm/landing_clearance"/>
      <input_port name="drone_id"    default="{drone_id}"/>
      <input_port name="timeout_sec" default="120"/>
    </Action>

    <Action ID="PublishLandingComplete">
      <input_port name="topic"    default="/swarm/landing_status"/>
      <input_port name="drone_id" default="{drone_id}"/>
    </Action>

    <Action ID="WaitForAllLanded">
      <input_port name="topic"          default="/swarm/landing_status"/>
      <input_port name="expected_count" default="{swarm_size}"/>
      <input_port name="timeout_sec"    default="180"/>
    </Action>

    <BehaviorTree ID="RTB">
      <input_port name="drone_id"/>
      <input_port name="leader_id"/>
      <input_port name="swarm_size"/>
      <input_port name="home_position"/>
    </BehaviorTree>

  </TreeNodesModel>

  <!-- ============================================================
       RTB
  ============================================================ -->
  <BehaviorTree ID="RTB">
    <Sequence name="ReturnAndLand">

      <!-- =====================================================
           Step 1: 홈 집결점 계산
           home_position 바로 상공이 아닌 외곽 집결점에서
           편대를 재구성하여 착륙 공역 혼잡 방지.
      ===================================================== -->
      <ComputeHomeRendezvous
        home_position="{home_position}"
        offset_m="80.0"
        home_rendezvous="{home_rendezvous}"/>

      <!-- =====================================================
           Step 2: 편대 재집결
      ===================================================== -->
      <Fallback name="ReassembleFormation">

        <!-- 리더: 집결점 선포 후 팔로워 집결 대기 -->
        <Sequence name="LeaderAssemble">
          <IsLeader drone_id="{drone_id}" leader_id="{leader_id}"/>
          <PublishRendezvous
            topic="/swarm/rtb_rendezvous"
            point="{home_rendezvous}"
            drone_id="{drone_id}"/>
          <GoTo
            target="{home_rendezvous}"
            speed_mps="6.0"
            acceptance_radius_m="10.0"/>
          <PublishFormationReady
            topic="/swarm/formation_status"
            drone_id="{drone_id}"/>
          <WaitForFormationAssembled
            topic="/swarm/formation_status"
            expected_count="{swarm_size}"
            timeout_sec="120"/>
        </Sequence>

        <!-- 팔로워: 집결점 수신 후 이동 -->
        <Sequence name="FollowerAssemble">
          <IsFollower drone_id="{drone_id}" leader_id="{leader_id}"/>
          <ReceiveRendezvous
            topic="/swarm/rtb_rendezvous"
            timeout_sec="60"
            rtb_point="{rtb_point}"/>
          <GoTo
            target="{rtb_point}"
            speed_mps="6.0"
            acceptance_radius_m="10.0"/>
          <PublishFormationReady
            topic="/swarm/formation_status"
            drone_id="{drone_id}"/>
        </Sequence>

      </Fallback>

      <!-- =====================================================
           Step 3: 홈 포지션 상공까지 편대 복귀 비행
      ===================================================== -->
      <GoToFormation
        target="{home_position}"
        formation_type="delta"
        speed_mps="8.0"
        leader_id="{leader_id}"
        drone_id="{drone_id}"/>

      <IsAtPosition
        target="{home_position}"
        tolerance_m="20.0"
        pose_topic="/self_localization/pose"/>

      <!-- =====================================================
           Step 4: 순차 착륙
           팔로워 번호 순 → 리더 마지막 착륙.
           착륙 슬롯 제어는 leader가 /swarm/landing_clearance 발행.
           각 드론은 자기 clearance 수신 시 착륙.
      ===================================================== -->
      <Sequence name="SequentialLanding">

        <!--
          착륙 허가 대기.
          리더는 자신이 마지막이므로 모든 팔로워 착륙 완료 후
          자기 자신에게 clearance를 발행하는 구조.
          팔로워는 /swarm/landing_clearance 토픽에서
          자신의 drone_id가 포함된 메시지 수신 시 착륙.
        -->
        <WaitForLandingClearance
          topic="/swarm/landing_clearance"
          drone_id="{drone_id}"
          timeout_sec="120"/>

        <!-- 착륙 실행 -->
        <Land speed="0.5"/>

        <!-- 착륙 완료 보고 -->
        <PublishLandingComplete
          topic="/swarm/landing_status"
          drone_id="{drone_id}"/>

        <!--
          리더: 모든 드론 착륙 완료 확인.
          팔로워: 이 노드는 IsLeader로 스킵.
        -->
        <Fallback name="FinalCheck">
          <IsFollower drone_id="{drone_id}" leader_id="{leader_id}"/>
          <Sequence>
            <IsLeader drone_id="{drone_id}" leader_id="{leader_id}"/>
            <WaitForAllLanded
              topic="/swarm/landing_status"
              expected_count="{swarm_size}"
              timeout_sec="180"/>
          </Sequence>
        </Fallback>

      </Sequence>

    </Sequence>
  </BehaviorTree>

</root>

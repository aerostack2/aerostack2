<?xml version="1.0"?>
<!--
  swarm_bt_combined.xml  —  Groot2 로드/시각화 확인용 단일 통합본
  swarm_root.xml + bootstrap/* + swarm_mission_root.xml + swarm_perdrone_root.xml
  + chassis/* + nodes_model.xml 을 <include> 없이 하나의 <root>로 병합.
  ※ 시각화 전용. 실행은 모듈 파일(include 구조) 사용. 트리 ID 중복 없음.
  Groot2: 좌측 트리목록에서 SwarmRoot (전 구간 통합) / SwarmCoord / SwarmDrone 선택.
-->
<root main_tree_to_execute="SwarmRoot">

  <!-- ==================== SWARM ROOT (최상위 진입점, WBS 1.6.8) ==================== -->

  <!-- 전 드론 공통 진입점. P0 부트스트랩 → IsLeader 자기선택 → SwarmCoord/SwarmDrone -->
  <BehaviorTree ID="SwarmRoot">
    <Parallel success_threshold="1" failure_threshold="1">
      <KeepRunningUntilFailure>
        <Action ID="PublishHeartbeat" topic_name="swarm/heartbeat"/>
      </KeepRunningUntilFailure>
      <SequenceStar>
        <SubTree ID="BootstrapAll" __shared_blackboard="true"/>
        <ReactiveFallback>
          <ReactiveSequence>
            <Condition ID="IsLeader"/>
            <SubTree ID="SwarmCoord" __shared_blackboard="true"/>
          </ReactiveSequence>
          <SubTree ID="SwarmDrone" __shared_blackboard="true"/>
        </ReactiveFallback>
      </SequenceStar>
    </Parallel>
  </BehaviorTree>

  <!-- ==================== BOOTSTRAP (P0, WBS 1.6.5) ==================== -->

  <!--
    P0 부트스트랩 시퀀스 (전 드론 공통).
    heartbeat RUNNING 유지 + 시퀀스(AwaitBoot→ReportHealth→SwarmJoin→QuorumReady→MissionReady).
    ★2 게이트: MissionReady SUCCESS = 임무 개시 자격 획득.
  -->
  <BehaviorTree ID="BootstrapAll">
    <Parallel success_threshold="1" failure_threshold="1">
      <KeepRunningUntilFailure>
        <Action ID="PublishHeartbeat" topic_name="swarm/heartbeat"/>
      </KeepRunningUntilFailure>
      <!--
        SwarmJoin FAILURE(health=FAIL 거부) 시 Dx_SafeHover로 격리.
        서비스 미발견 → RUNNING(재시도). accepted=false → FAILURE → SafeHover.
        my_slot은 /{ns}/swarm_agent/task.takeoff_slot 에서 직접 읽음.
      -->
      <Fallback>
        <SequenceStar>
          <Condition ID="AwaitBoot"/>
          <Action ID="ReportHealth" topic_name="swarm/heartbeat"/>
          <Action ID="SwarmJoin" service_name="swarm/join"/>
          <Condition ID="QuorumReady"/>
          <Condition ID="MissionReady"/>
        </SequenceStar>
        <SubTree ID="Dx_SafeHover" __shared_blackboard="true"/>
      </Fallback>
    </Parallel>
  </BehaviorTree>

  <!-- ==================== COORDINATOR ==================== -->
  <BehaviorTree ID="SwarmCoord">
    <Parallel success_threshold="1" failure_threshold="1">
      <Decorator ID="WaitForAlert" topic_name="alert_event">
        <SubTree ID="EmergencyAll" __shared_blackboard="true"/>
      </Decorator>
      <Decorator ID="LatchMissionType" topic_name="swarm/mission_intent" lock_phases="WORK,LANDING">
        <ReactiveFallback>
          <ReactiveSequence>
            <Condition ID="HasMissionType" type="{mtype}" match="EOIR_RECON"/>
            <SubTree ID="EoirReconCoord" __shared_blackboard="true"/>
          </ReactiveSequence>
          <ReactiveSequence>
            <Condition ID="HasMissionType" type="{mtype}" match="RF_RECON"/>
            <SubTree ID="RfReconCoord" __shared_blackboard="true"/>
          </ReactiveSequence>
          <ReactiveSequence>
            <Condition ID="HasMissionType" type="{mtype}" match="SURVEIL"/>
            <SubTree ID="SurveilCoord" __shared_blackboard="true"/>
          </ReactiveSequence>
          <ReactiveSequence>
            <Condition ID="HasMissionType" type="{mtype}" match="TRACK"/>
            <SubTree ID="TrackCoord" __shared_blackboard="true"/>
          </ReactiveSequence>
          <SubTree ID="StandbyCoord" __shared_blackboard="true"/>
        </ReactiveFallback>
      </Decorator>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="EoirReconCoord">
    <SequenceStar>
      <SubTree ID="Cx_SequentialTakeoff" __shared_blackboard="true"/>
      <Action ID="PublishPhase" phase="TRANSIT"/>
      <SubTree ID="Cx_FormUp" __shared_blackboard="true"/>
      <Action ID="DriveCentroid" target="{recon_entry}" speed="4.0"/>
      <Action ID="PublishPhase" phase="WORK"/>
      <SubTree ID="EoirReconP3Coord" __shared_blackboard="true"/>
      <Action ID="PublishPhase" phase="REGROUP"/>
      <SubTree ID="Cx_Regroup" __shared_blackboard="true"/>
      <Action ID="DriveCentroid" target="{home}" speed="4.0"/>
      <SubTree ID="Cx_SequentialLand" __shared_blackboard="true"/>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="EoirReconP3Coord">
    <SequenceStar>
      <Action ID="SwarmFlockingStop"/>
      <Action ID="PartitionAndAssign" zones="{recon_area}" route_out="swarm_agent/task"/>
      <Parallel success_threshold="1" failure_threshold="1">
        <Action ID="FuseDetections" in="perception/detections" out="swarm/targets"/>
        <Condition ID="AwaitAllZonesDone"/>
      </Parallel>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="RfReconCoord">
    <SequenceStar>
      <SubTree ID="Cx_SequentialTakeoff" __shared_blackboard="true"/>
      <Action ID="PublishPhase" phase="TRANSIT"/>
      <SubTree ID="Cx_FormUp" __shared_blackboard="true"/>
      <Action ID="DriveCentroid" target="{recon_entry}" speed="4.0"/>
      <Action ID="PublishPhase" phase="WORK"/>
      <SubTree ID="RfReconP3Coord" __shared_blackboard="true"/>
      <Action ID="PublishPhase" phase="REGROUP"/>
      <Action ID="DriveCentroid" target="{home}" speed="4.0"/>
      <SubTree ID="Cx_SequentialLand" __shared_blackboard="true"/>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="RfReconP3Coord">
    <SequenceStar>
      <Action ID="AssignRfSurvey" route_out="swarm_agent/task" mode="triangulate"/>
      <Parallel success_threshold="1" failure_threshold="1">
        <Action ID="DriveCentroid" target="{rf_survey_route}" speed="2.0"/>
        <Action ID="FuseEmitters" in="rf/bearings" out="swarm/emitters"/>
        <Condition ID="AwaitAllZonesDone"/>
      </Parallel>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="SurveilCoord">
    <SequenceStar>
      <SubTree ID="Cx_SequentialTakeoff" __shared_blackboard="true"/>
      <Action ID="PublishPhase" phase="TRANSIT"/>
      <SubTree ID="Cx_FormUp" __shared_blackboard="true"/>
      <Action ID="DriveCentroid" target="{surveil_entry}" speed="4.0"/>
      <Action ID="PublishPhase" phase="WORK"/>
      <SubTree ID="SurveilP3Coord" __shared_blackboard="true"/>
      <Action ID="PublishPhase" phase="REGROUP"/>
      <SubTree ID="Cx_Regroup" __shared_blackboard="true"/>
      <Action ID="DriveCentroid" target="{home}" speed="4.0"/>
      <SubTree ID="Cx_SequentialLand" __shared_blackboard="true"/>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="SurveilP3Coord">
    <SequenceStar>
      <Action ID="SwarmFlockingStop"/>
      <Action ID="PartitionAndAssign" zones="{surveil_posts}" route_out="swarm_agent/task"/>
      <Parallel success_threshold="1" failure_threshold="1">
        <Action ID="FuseDetections" in="perception/detections" out="swarm/targets"/>
        <Condition ID="AwaitAllZonesDone"/>
      </Parallel>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="TrackCoord">
    <SequenceStar>
      <SubTree ID="Cx_SequentialTakeoff" __shared_blackboard="true"/>
      <Action ID="PublishPhase" phase="TRANSIT"/>
      <SubTree ID="Cx_FormUp" __shared_blackboard="true"/>
      <Action ID="DriveCentroid" target="{track_entry}" speed="4.0"/>
      <Action ID="PublishPhase" phase="WORK"/>
      <SubTree ID="TrackP3Coord" __shared_blackboard="true"/>
      <Action ID="PublishPhase" phase="REGROUP"/>
      <SubTree ID="Cx_Regroup" __shared_blackboard="true"/>
      <Action ID="DriveCentroid" target="{home}" speed="4.0"/>
      <SubTree ID="Cx_SequentialLand" __shared_blackboard="true"/>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="TrackP3Coord">
    <KeepRunningUntilFailure>
      <Action ID="AllocateTrackRoles" target_in="swarm/targets" role_out="swarm_agent/task"/>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <BehaviorTree ID="EmergencyAll">
    <SequenceStar>
      <Action ID="SwarmFlockingStop"/>
      <Action ID="PublishPhase" phase="EMERGENCY"/>
      <Condition ID="AwaitAllLanded"/>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="StandbyCoord">
    <Action ID="PublishPhase" phase="STANDBY"/>
  </BehaviorTree>

  <!-- ===== chassis (coordinator) ===== -->
  <BehaviorTree ID="Cx_SequentialTakeoff">
    <SequenceStar>
      <Action ID="PublishPhase" phase="TAKEOFF"/>
      <Condition ID="AwaitAllAirborne"/>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="Cx_FormUp">
    <SequenceStar>
      <!--
        SwarmFlockingStart: fire-and-forget. 편대 명령 발행 후 즉시 SUCCESS.
        수렴 판정은 AwaitFormed(M08 aggregator) 단독 담당.
        이중 대기 방지: AS2 action 완료 ≠ M08 formed 판정 시점.
      -->
      <Action ID="SwarmFlockingStart" formation="line" spacing="5.0"/>
      <Condition ID="AwaitFormed"/>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="Cx_Regroup">
    <SequenceStar>
      <Action ID="ModifyFormation" formation="line"/>
      <Condition ID="AwaitFormed"/>
    </SequenceStar>
  </BehaviorTree>

  <BehaviorTree ID="Cx_SequentialLand">
    <SequenceStar>
      <Action ID="SwarmFlockingStop"/>
      <Action ID="PublishPhase" phase="LANDING"/>
      <Condition ID="AwaitAllLanded"/>
    </SequenceStar>
  </BehaviorTree>

  <!-- ==================== PER-DRONE ==================== -->
  <BehaviorTree ID="SwarmDrone">
    <Parallel success_threshold="1" failure_threshold="1">
      <!-- 선점 1: 비상 이벤트 (E1/E3) -->
      <Decorator ID="WaitForAlert" topic_name="alert_event">
        <SubTree ID="Dx_Emergency" __shared_blackboard="true"/>
      </Decorator>
      <!-- 선점 2: 배터리 저하 RTB (E2). 배터리OK 동안 RUNNING -->
      <Decorator ID="AwaitBatteryLow" threshold="0.25">
        <SubTree ID="Dx_BatteryRTB" __shared_blackboard="true"/>
      </Decorator>
      <ReactiveFallback>
        <ReactiveSequence>
          <Condition ID="HasMissionType" type="{mtype}" match="EOIR_RECON"/>
          <SubTree ID="EoirReconDrone" __shared_blackboard="true"/>
        </ReactiveSequence>
        <ReactiveSequence>
          <Condition ID="HasMissionType" type="{mtype}" match="RF_RECON"/>
          <SubTree ID="RfReconDrone" __shared_blackboard="true"/>
        </ReactiveSequence>
        <ReactiveSequence>
          <Condition ID="HasMissionType" type="{mtype}" match="SURVEIL"/>
          <SubTree ID="SurveilDrone" __shared_blackboard="true"/>
        </ReactiveSequence>
        <ReactiveSequence>
          <Condition ID="HasMissionType" type="{mtype}" match="TRACK"/>
          <SubTree ID="TrackDrone" __shared_blackboard="true"/>
        </ReactiveSequence>
        <SubTree ID="Dx_SafeHover" __shared_blackboard="true"/>
      </ReactiveFallback>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="EoirReconDrone">
    <ReactiveFallback>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="TAKEOFF"/>
        <SubTree ID="Dx_ArmTakeoff" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="TRANSIT"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="WORK"/>
        <SubTree ID="EoirReconP3Drone" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="REGROUP"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="LANDING"/>
        <SubTree ID="Dx_LandSlot" __shared_blackboard="true"/>
      </ReactiveSequence>
      <SubTree ID="Dx_SafeHover" __shared_blackboard="true"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="EoirReconP3Drone">
    <ReactiveFallback>
      <ReactiveSequence>
        <Condition ID="ObjectDetected" topic_name="perception/detections"
                   min_score="0.6" target_pose="{detection_pose}"/>
        <SubTree ID="InspectTarget" __shared_blackboard="true"/>
      </ReactiveSequence>
      <Parallel success_threshold="1" failure_threshold="3">
        <Action ID="FollowPath" path="{sub_route}" speed="3.0" yaw_mode="1"/>
        <KeepRunningUntilFailure>
          <Action ID="PointGimbal" frame_id="earth" mode="2" pitch="1.57"/>
        </KeepRunningUntilFailure>
        <KeepRunningUntilFailure>
          <Action ID="DetectObjects" server_name="DetectObjectsBehavior" min_score="0.5"/>
        </KeepRunningUntilFailure>
      </Parallel>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="InspectTarget">
    <Parallel success_threshold="1" failure_threshold="2">
      <Action ID="GoTo" pose="{detection_pose}" max_speed="2.0" yaw_mode="1"/>
      <KeepRunningUntilFailure>
        <Action ID="PointGimbal" frame_id="earth" mode="2" pitch="1.57"/>
      </KeepRunningUntilFailure>
      <KeepRunningUntilFailure>
        <Action ID="DetectObjects" server_name="DetectObjectsBehavior" min_score="0.5"/>
      </KeepRunningUntilFailure>
      <Inverter>
        <Condition ID="InspectTimeout" duration="15.0"/>
      </Inverter>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="RfReconDrone">
    <ReactiveFallback>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="TAKEOFF"/>
        <SubTree ID="Dx_ArmTakeoff" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="TRANSIT"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="WORK"/>
        <SubTree ID="RfReconP3Drone" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="REGROUP"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="LANDING"/>
        <SubTree ID="Dx_LandSlot" __shared_blackboard="true"/>
      </ReactiveSequence>
      <SubTree ID="Dx_SafeHover" __shared_blackboard="true"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="RfReconP3Drone">
    <Parallel success_threshold="1" failure_threshold="2">
      <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      <KeepRunningUntilFailure>
        <Action ID="RfSurvey" route="{sub_route}" mode="triangulate"/>
      </KeepRunningUntilFailure>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="SurveilDrone">
    <ReactiveFallback>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="TAKEOFF"/>
        <SubTree ID="Dx_ArmTakeoff" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="TRANSIT"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="WORK"/>
        <SubTree ID="SurveilP3Drone" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="REGROUP"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="LANDING"/>
        <SubTree ID="Dx_LandSlot" __shared_blackboard="true"/>
      </ReactiveSequence>
      <SubTree ID="Dx_SafeHover" __shared_blackboard="true"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="SurveilP3Drone">
    <Parallel success_threshold="1" failure_threshold="3">
      <KeepRunningUntilFailure>
        <Action ID="FollowPath" path="{loiter_route}" speed="1.0" yaw_mode="1"/>
      </KeepRunningUntilFailure>
      <KeepRunningUntilFailure>
        <Action ID="PointGimbal" frame_id="earth" mode="2" pitch="1.57"/>
      </KeepRunningUntilFailure>
      <KeepRunningUntilFailure>
        <Action ID="DetectObjects" server_name="DetectObjectsBehavior" min_score="0.5"/>
      </KeepRunningUntilFailure>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="TrackDrone">
    <ReactiveFallback>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="TAKEOFF"/>
        <SubTree ID="Dx_ArmTakeoff" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="TRANSIT"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="WORK"/>
        <SubTree ID="TrackP3Drone" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="REGROUP"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="PhaseIs" phase="LANDING"/>
        <SubTree ID="Dx_LandSlot" __shared_blackboard="true"/>
      </ReactiveSequence>
      <SubTree ID="Dx_SafeHover" __shared_blackboard="true"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="TrackP3Drone">
    <ReactiveFallback>
      <ReactiveSequence>
        <Condition ID="HasRole" role="{role}" match="TRACKER"/>
        <Parallel success_threshold="1" failure_threshold="2">
          <Action ID="GoTo" pose="{track_target}" max_speed="4.0" yaw_mode="1"/>
          <KeepRunningUntilFailure>
            <Action ID="PointGimbal" frame_id="earth" mode="2" pitch="1.0"/>
          </KeepRunningUntilFailure>
        </Parallel>
      </ReactiveSequence>
      <ReactiveSequence>
        <Condition ID="HasRole" role="{role}" match="RELAY"/>
        <SubTree ID="Dx_HoldFormation" __shared_blackboard="true"/>
      </ReactiveSequence>
      <SubTree ID="Dx_SafeHover" __shared_blackboard="true"/>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- ===== chassis (per-drone) ===== -->
  <!--
    Dx_ArmTakeoff: 이륙 순번 대기 → Arm/Offboard/Takeoff.
    Timeout(60s): FCU 영구 고장 시 무한 재시도 탈출 → Fallback → IsFlying 재확인.
    WaitTakeoffSlot: swarm/telemetry(SwarmTelemetry) + swarm_agent/task.takeoff_slot 기반.
  -->
  <BehaviorTree ID="Dx_ArmTakeoff">
    <Fallback>
      <Condition ID="IsFlying"/>
      <Decorator ID="WaitTakeoffSlot" topic_name="swarm/telemetry" task_topic="swarm_agent/task">
        <Decorator ID="Timeout" msec="60000">
          <RetryUntilSuccessful num_attempts="-1">
            <SequenceStar>
              <Action ID="Arm"      service_name="set_arming_state"/>
              <Action ID="Offboard" service_name="set_offboard_mode"/>
              <Action ID="Takeoff"  height="20.0" speed="2.0"/>
            </SequenceStar>
          </RetryUntilSuccessful>
        </Decorator>
      </Decorator>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="Dx_HoldFormation">
    <Action ID="FollowReference" server_name="FollowReferenceBehavior"/>
  </BehaviorTree>

  <BehaviorTree ID="Dx_LandSlot">
    <Decorator ID="WaitLandSlot" topic_name="swarm/telemetry" task_topic="swarm_agent/task">
      <Action ID="Land" speed="0.5"/>
    </Decorator>
  </BehaviorTree>

  <BehaviorTree ID="Dx_SafeHover">
    <Action ID="SafeHover"/>
  </BehaviorTree>

  <BehaviorTree ID="Dx_Emergency">
    <Fallback>
      <SequenceStar>
        <Action ID="GoTo" pose="{home}" max_speed="3.0"/>
        <Action ID="Land" speed="0.5"/>
      </SequenceStar>
      <Action ID="SafeHover"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="Dx_BatteryRTB">
    <Fallback>
      <SequenceStar>
        <Action ID="GoTo" pose="{home}" max_speed="4.0"/>
        <Action ID="Land" speed="0.5"/>
      </SequenceStar>
      <Action ID="SafeHover"/>
    </Fallback>
  </BehaviorTree>

  <!-- ==================== 노드 모델 ==================== -->
  <TreeNodesModel>
    <!-- §6.1 군집 조율 -->
    <Condition ID="HasMissionType">
      <input_port name="type">현재 임무종류 (블랙보드 {mtype})</input_port>
      <input_port name="match">EOIR_RECON / RF_RECON / SURVEIL / TRACK</input_port>
    </Condition>
    <Decorator ID="LatchMissionType">
      <input_port name="topic_name" default="swarm/mission_intent">임무 의도 토픽</input_port>
      <input_port name="lock_phases" default="WORK,LANDING">타입전환 금지 단계</input_port>
    </Decorator>
    <Action ID="PublishPhase">
      <input_port name="phase">TAKEOFF/TRANSIT/WORK/REGROUP/LANDING/EMERGENCY/STANDBY</input_port>
    </Action>
    <Action ID="SwarmFlockingStart">
      <input_port name="formation" default="line">편대 형태</input_port>
      <input_port name="spacing" default="5.0">기체 간격 (m)</input_port>
      <input_port name="centroid" default="">virtual_centroid</input_port>
    </Action>
    <Action ID="SwarmFlockingStop"/>
    <Action ID="ModifyFormation">
      <input_port name="formation" default="line">modify_swarm 재편대/detach</input_port>
    </Action>
    <Action ID="DriveCentroid">
      <input_port name="target">목표점 또는 블랙보드</input_port>
      <input_port name="speed" default="4.0">centroid 이동 속도 (m/s)</input_port>
    </Action>
    <!-- §6.2 동기 barrier -->
    <Condition ID="AwaitAllAirborne"/>
    <Condition ID="AwaitFormed"/>
    <Condition ID="AwaitAllZonesDone"/>
    <Condition ID="AwaitAllLanded"/>
    <!-- §6.3 per-drone 게이트/슬롯 -->
    <Condition ID="PhaseIs">
      <input_port name="phase">현 단계 == match (/swarm/mission_phase)</input_port>
    </Condition>
    <Decorator ID="WaitForAlert">
      <input_port name="topic_name">AlertEvent 토픽</input_port>
      <output_port name="alert">수신 alert 코드</output_port>
    </Decorator>
    <Decorator ID="WaitTakeoffSlot">
      <input_port name="topic_name" default="swarm/telemetry">전 드론 텔레메트리</input_port>
      <input_port name="task_topic" default="swarm_agent/task">자기 배정 (takeoff_slot)</input_port>
    </Decorator>
    <Decorator ID="WaitLandSlot">
      <input_port name="topic_name" default="swarm/telemetry">전 드론 텔레메트리</input_port>
      <input_port name="task_topic" default="swarm_agent/task">자기 배정 (land_slot)</input_port>
    </Decorator>
    <Action ID="SafeHover"/>
    <!-- §6.4 임무 P3 전용 -->
    <Action ID="PartitionAndAssign">
      <input_port name="zones">구역 폴리곤</input_port>
      <input_port name="route_out" default="swarm_agent/task">분할 sub_route 배포</input_port>
    </Action>
    <Action ID="AssignRfSurvey">
      <input_port name="route_out" default="swarm_agent/task">측위 경로/형태 배포</input_port>
      <input_port name="mode" default="triangulate">triangulate/df/loiter_peak</input_port>
    </Action>
    <Action ID="FuseDetections">
      <input_port name="in" default="perception/detections">드론별 탐지</input_port>
      <input_port name="out" default="swarm/targets">융합 표적</input_port>
    </Action>
    <Action ID="FuseEmitters">
      <input_port name="in" default="rf/bearings">드론별 방위</input_port>
      <input_port name="out" default="swarm/emitters">삼각측량 방사원</input_port>
    </Action>
    <Action ID="AllocateTrackRoles">
      <input_port name="target_in" default="swarm/targets">표적 입력</input_port>
      <input_port name="role_out" default="swarm_agent/task">TRACKER/RELAY 배포</input_port>
    </Action>
    <Action ID="DetectObjects">
      <input_port name="server_name" default="DetectObjectsBehavior">액션서버</input_port>
      <input_port name="classes">탐지 클래스 필터</input_port>
      <input_port name="min_score" default="0.5">신뢰도 임계</input_port>
    </Action>
    <Condition ID="ObjectDetected">
      <input_port name="topic_name" default="perception/detections">탐지 토픽</input_port>
      <input_port name="min_score" default="0.6">선점 임계</input_port>
      <output_port name="target_pose">표적 world 좌표 → {detection_pose}</output_port>
    </Condition>
    <Condition ID="InspectTimeout">
      <input_port name="duration" default="15.0">관측 지속 (sec)</input_port>
    </Condition>
    <Action ID="RfSurvey">
      <input_port name="route">측위 경로 {sub_route}</input_port>
      <input_port name="mode" default="triangulate">RF 기동</input_port>
    </Action>
    <Condition ID="EmitterDetected">
      <input_port name="topic_name" default="rf/bearings">RF 방위 토픽</input_port>
      <output_port name="emitter_pose">방사원 위치 → {emitter_pose}</output_port>
    </Condition>
    <Condition ID="HasRole">
      <input_port name="role">역할 {role}</input_port>
      <input_port name="match">TRACKER / RELAY</input_port>
    </Condition>
    <Condition ID="TargetLost">
      <input_port name="topic_name" default="swarm/targets">표적 토픽</input_port>
    </Condition>
    <!-- §6.5 부트스트랩 노드 (P0) -->
    <Condition ID="AwaitBoot"/>
    <Action ID="ReportHealth">
      <input_port name="topic_name" default="swarm/heartbeat"/>
    </Action>
    <Action ID="PublishHeartbeat">
      <input_port name="topic_name" default="swarm/heartbeat"/>
    </Action>
    <Action ID="SwarmJoin">
      <input_port name="service_name" default="swarm/join"/>
      <output_port name="my_slot">{my_slot}</output_port>
    </Action>
    <Condition ID="IsLeader"/>
    <Condition ID="QuorumReady"/>
    <Condition ID="MissionReady"/>
    <!-- 안전/공통 -->
    <Condition ID="IsFlying"/>
    <Condition ID="BatteryLow">
      <input_port name="threshold" default="0.25">RTB 임계</input_port>
    </Condition>
    <Decorator ID="AwaitBatteryLow">
      <input_port name="threshold" default="0.25"/>
    </Decorator>
    <!-- 재사용: AS2 BT 노드 -->
    <Action ID="Arm">
      <input_port name="service_name" default="set_arming_state"/>
    </Action>
    <Action ID="Offboard">
      <input_port name="service_name" default="set_offboard_mode"/>
    </Action>
    <Action ID="Takeoff">
      <input_port name="height" default="2.0">이륙 고도 (m)</input_port>
      <input_port name="speed" default="0.5">이륙 속도 (m/s)</input_port>
    </Action>
    <Action ID="Land">
      <input_port name="speed" default="0.5">착륙 속도 (m/s)</input_port>
    </Action>
    <Action ID="GoTo">
      <input_port name="pose">목표 위치 또는 블랙보드</input_port>
      <input_port name="max_speed">최대 속도 (m/s)</input_port>
      <input_port name="yaw_angle" default="0.0">목표 요 (rad)</input_port>
      <input_port name="yaw_mode" default="0">0=KEEP 1=PATH 2=FIXED</input_port>
    </Action>
    <Action ID="FollowPath">
      <input_port name="path">웨이포인트 또는 {sub_route}</input_port>
      <input_port name="speed">최대 속도 (m/s)</input_port>
      <input_port name="yaw_mode" default="1">0=KEEP 1=PATH 2=FIXED</input_port>
    </Action>
    <Action ID="FollowReference">
      <input_port name="server_name" default="FollowReferenceBehavior">슬롯 추종</input_port>
    </Action>
    <Action ID="PointGimbal">
      <input_port name="frame_id" default="earth">기준 프레임</input_port>
      <input_port name="mode" default="2">짐벌 모드</input_port>
      <input_port name="yaw" default="0.0">요 (rad)</input_port>
      <input_port name="pitch" default="1.57">피치 (rad, 1.57=하향)</input_port>
      <input_port name="roll" default="0.0">롤 (rad)</input_port>
    </Action>
  </TreeNodesModel>

</root>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>as2_state_interface</name>
  <version>0.0.0</version>
  <description>Backwards-compatible shim for StateInterface, a typed subscription-backed state accessor for Aerostack2 cognitive modules (now in as2_core; CoreSense Resilience Essential, WP7/TB2)</description>
  <maintainer email="g.glenza@upm.es">Guillermo GP-Lenza</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>as2_core</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

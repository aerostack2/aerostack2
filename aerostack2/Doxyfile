# Only the settings that differ from the Doxygen defaults.
PROJECT_NAME           = Aerostack2
PROJECT_BRIEF          = "C++ Aerostack2 API"
OUTPUT_DIRECTORY       = doxygen

TAB_SIZE               = 2
TOC_INCLUDE_HEADINGS   = 5
BUILTIN_STL_SUPPORT    = YES
CASE_SENSE_NAMES       = YES

INPUT                  = ../
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cpp \
                         *.c++ \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp \
                         *.h++
RECURSIVE              = YES
EXCLUDE                = doxygen
EXCLUDE_PATTERNS       = */build/* \
                         */tests/* \
                         */cmake/* \
                         */indi_control/* \
                         */thirdparty/* \
                         */thirdparties/* \
                         */ekf_c_code.*
IMAGE_PATH             = ../as2_core/docs/images/

# node.hpp selects the base class of as2::Node and its members with these macros.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
EXPAND_AS_DEFINED      = AS2_NODE_FATHER_TYPE \
                         AS2_NODE_FATHER \
                         AS2_RCLCPP_NODE \
                         AS2_LIFECYLCE_NODE
